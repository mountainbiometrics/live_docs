        "show_node_options": {
          "ext": false,
          "alias": true,
          "folder": false
        }
      }
    },
    "freeze_implied_edges": {
      "default_options": {
        "destination": "frontmatter",
        "included_fields": [],
        "use_alias": true
      }
    },
    "thread": {
      "default_options": {
        "destination": "frontmatter",
        "target_path_template": "{{source.folder}}/{{attr.field}} {{source.basename}}"
      }
