  "implied_relations": {
    "transitive": [
      {
        "name": "implied-child",
        "rounds": 1,
        "chain": [
          {
            "field": "belongs_to"
          }
        ],
        "close_field": "belongs_to",
        "close_reversed": true
      },
      {
        "name": "implied-relates-symmetric",
        "rounds": 1,
        "chain": [
          {
            "field": "relates"
          }
        ],
        "close_field": "relates",
        "close_reversed": true
      },
      {
        "name": "implied-supersedes",
        "rounds": 1,
        "chain": [
          {
            "field": "superseded_by"
          }
        ],
        "close_field": "superseded_by",
        "close_reversed": true
      }
    ]
  },
