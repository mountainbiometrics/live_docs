        "default_depth": 5,
        "lock_view": false,
        "lock_path": "",
        "field_group_labels": [
          "parents",
          "children"
        ],
        "edge_sort_id": {
          "field": "basename",
          "order": 1
        },
        "show_node_options": {
          "ext": false,
          "folder": false,
          "alias": false
        },
        "find_root": true,
