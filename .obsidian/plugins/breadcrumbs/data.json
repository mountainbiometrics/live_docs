      "month": {
        "enabled": false,
        "date_format": "yyyy-MM",
        "folder": "",
        "next_field": "relates",
        "up_field": "belongs_to"
      },
      "quarter": {
        "enabled": false,
        "date_format": "yyyy-'Q'q",
        "folder": "",
        "next_field": "relates",
        "up_field": "belongs_to"
      },
      "year": {
        "enabled": false,
        "date_format": "yyyy",
        "folder": "",
        "next_field": "relates",
        "up_field": "belongs_to"
      }
